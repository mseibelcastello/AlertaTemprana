<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.AlertaTemprana" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primario</item>
        <item name="android:colorPrimaryDark">@color/primario</item>
        <item name="android:colorAccent">@color/secundario</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:statusBarColor">@color/fondo</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:buttonStyle">@style/BotonApp</item>
    </style>

    <style name="BotonApp" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_boton</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TituloMetro">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_principal</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

</resources>